# Copy to .env and fill in secrets. See AGENTS.md "Environment" and
# apps/api/app/config.py for the authoritative field list and defaults.
# Never commit the real .env (see .gitignore).

# --- LLM provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=
LLM_TEMPERATURE=0.0

# --- Relational DB ---
# Host port is 5433, not 5432 (docker-compose.yml maps 5433->5432 to avoid
# colliding with a native/Homebrew Postgres that may already own 5432).
DATABASE_URL=postgresql+psycopg://skillbridge:skillbridge@localhost:5433/skillbridge

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Vector store ---
VECTOR_BACKEND=memory
PINECONE_API_KEY=
PINECONE_DENSE_INDEX=skillbridge-dense
PINECONE_SPARSE_INDEX=skillbridge-sparse
PINECONE_ENV=dev
PINECONE_LOCAL_HOST=http://localhost:5080

# --- Models ---
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
SPARSE_MODEL=pinecone-sparse-english-v0
RERANK_MODEL=bge-reranker-v2-m3
RERANK_ENABLED=false

# --- Scoring guardrails (PRD §9; recommendations only) ---
SCORING_MIN_CONFIDENCE=0.5
KEYWORD_STUFFING_RATIO_THRESHOLD=0.8
KEYWORD_STUFFING_MIN_SKILLS=5
KEYWORD_STUFFING_MAX_PENALTY=0.1

# --- Optional ---
GITHUB_TOKEN=

# --- Freshness wait (PRD §8.6) ---
VECTOR_FRESHNESS_TIMEOUT_S=15.0

# --- Upsert batching (AGENTS.md "Pinecone rules") ---
PINECONE_UPSERT_BATCH_SIZE=100
PINECONE_UPSERT_MAX_RETRIES=3

# --- Hybrid retrieval (PRD §8.4, M1 app/rag/retriever.py) ---
RRF_K=60
RETRIEVER_TOP_K=20
RETRIEVER_FINAL_K=5

# --- Intake worker (PRD §13 — simple poller, not a task queue) ---
WORKER_POLL_INTERVAL_S=3.0

# --- Applicant upload (PRD F1.2) ---
RESUME_UPLOAD_MAX_MB=5.0
RESUME_UPLOAD_DIR=data/uploads

# --- CORS ---
# pydantic-settings parses this as JSON for a list[str] field.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
